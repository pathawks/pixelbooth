# Copy this file to .env.local and set the Xcode installation to use for this repo.
DEVELOPER_DIR="/Applications/Xcode.app/Contents/Developer"

# Optional build-time preset: SmallF16 (default) or SmallF32.
# An explicit preset bypasses the git-ignored depth-model.local.json override.
# export PIXELBOOTH_DEPTH_VARIANT="SmallF16"
# export PIXELBOOTH_DEPTH_OVERRIDE="/absolute/path/to/private-model.json"
